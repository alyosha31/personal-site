---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    date: post.data.date.toISOString().slice(0, 10),
    description: post.data.description,
    tags: post.data.tags,
    href: `/writing/${post.id}/`,
  }));
const serializedPosts = JSON.stringify(posts).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Alyosha's terminal — writing, projects, and notes from the messy middle." />
    <meta name="theme-color" content="#090c0a" />
    <title>alyosha@personal-site:~</title>
  </head>
  <body>
    <main class="terminal-app" id="terminal-app">
      <header class="topbar">
        <a class="host" href="/" aria-label="Homepage">
          <span class="host-mark">●</span>
          alyosha@personal-site
        </a>
        <div class="topbar-center">bash — 80×24</div>
        <div class="topbar-actions">
          <button type="button" data-command="theme" aria-label="Change terminal theme">theme</button>
          <a href="https://github.com/alyosha31" target="_blank" rel="noreferrer">github ↗</a>
        </div>
      </header>

      <section class="terminal-screen" aria-label="Interactive terminal">
        <div class="terminal-output" id="terminal-output" aria-live="polite" aria-atomic="false">
          <div class="boot" aria-label="Welcome">
            <pre class="ascii" aria-hidden="true">
 █████╗ ██╗  ██╗   ██╗ ██████╗ ███████╗██╗  ██╗ █████╗
██╔══██╗██║  ╚██╗ ██╔╝██╔═══██╗██╔════╝██║  ██║██╔══██╗
███████║██║   ╚████╔╝ ██║   ██║███████╗███████║███████║
██╔══██║██║    ╚██╔╝  ██║   ██║╚════██║██╔══██║██╔══██║
██║  ██║███████╗██║   ╚██████╔╝███████║██║  ██║██║  ██║
╚═╝  ╚═╝╚══════╝╚═╝    ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝</pre>
            <div class="boot-copy">
              <p><span class="green">personal-site</span> <span class="dim">v1.0.0</span></p>
              <p>Writing about technology, creative work, and things I learn while building.</p>
              <p class="dim">Type <button type="button" class="inline-command" data-command="help">help</button> to see available commands, or click a shortcut below.</p>
            </div>
            <div class="quick-commands" aria-label="Quick commands">
              <button type="button" data-command="writing">writing</button>
              <button type="button" data-command="projects">projects</button>
              <button type="button" data-command="about">about</button>
              <button type="button" data-command="contact">contact</button>
            </div>
          </div>
        </div>

        <form class="prompt-row" id="terminal-form" autocomplete="off">
          <label class="prompt" for="terminal-input">
            <span class="prompt-user">alyosha</span><span class="dim">@</span><span class="prompt-host">personal-site</span><span class="dim">:</span><span class="prompt-path">~</span><span class="prompt-symbol">$</span>
          </label>
          <div class="input-wrap">
            <input
              id="terminal-input"
              name="command"
              type="text"
              inputmode="text"
              enterkeyhint="send"
              aria-label="Terminal command"
              aria-describedby="terminal-hint"
              spellcheck="false"
              autocapitalize="none"
              autocomplete="off"
            />
            <span class="block-cursor" aria-hidden="true"></span>
          </div>
        </form>

        <div class="suggestions" id="suggestions" hidden aria-label="Command suggestions"></div>
      </section>

      <footer class="terminal-footer">
        <p id="terminal-hint"><kbd>↑</kbd><kbd>↓</kbd> history <kbd>tab</kbd> complete <kbd>ctrl</kbd>+<kbd>l</kbd> clear</p>
        <p><span class="status-dot"></span> guest session · <span id="clock">--:--:--</span></p>
      </footer>
    </main>

    <script id="posts-data" type="application/json" set:html={serializedPosts}></script>
    <script src="../scripts/terminal.ts"></script>
  </body>
</html>
