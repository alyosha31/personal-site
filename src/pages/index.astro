---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteLayout
  description="Alyosha's personal site — writing, projects, and notes."
  shellClass="home-shell"
>
      <section>
        <h2>Writing</h2>
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/writing/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              <span>{post.data.title}</span>
            </a>
          ))}
        </div>
        <p class="section-more"><a href="/writing/">All writing →</a></p>
      </section>

      <section>
        <h2>Projects</h2>
        <div class="project-list">
          <article>
            <div>
              <h3>cloud-sandbox</h3>
              <p>An HTTP sandbox for safely running code and tools on behalf of AI agents.</p>
            </div>
            <a href="https://github.com/alyosha31/cloud-sandbox">Source →</a>
          </article>
          <article>
            <div>
              <h3>Personal site</h3>
              <p>A small home for my writing, experiments, and things I want to remember.</p>
            </div>
            <a href="https://github.com/alyosha31/personal-site">Source →</a>
          </article>
        </div>
      </section>

      <section>
        <h2>Who I am</h2>
        <p>
          I’m Mohit Guleria, usually Alyosha online. I did my undergrad at IIT
          Roorkee, and I’m a builder in the machine-learning space.
        </p>
        <p>
          I want to work on the systems problems around AI agents: how they run
          code safely, how we evaluate whether they actually work, and how we
          build the infrastructure that makes them dependable. I like working
          close to the machinery—runtimes, sandboxes, developer tools, and the
          lower-level pieces behind intelligent software.
        </p>
      </section>

      <section>
        <h2>Elsewhere</h2>
        <ul class="link-list">
          <li><a href="https://github.com/alyosha31">GitHub</a> — code and ongoing work</li>
          <li><a href="https://github.com/alyosha31/personal-site">This website</a> — source repository</li>
        </ul>
      </section>

      <footer>
        <p>Built with Astro. No tracking, no cookies.</p>
      </footer>
</SiteLayout>
