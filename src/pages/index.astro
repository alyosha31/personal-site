---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const visibleProjects = (await getCollection('projects'))
  .filter((project) => !project.data.draft);

const compareProjects = (a: typeof visibleProjects[number], b: typeof visibleProjects[number]) =>
  a.data.order - b.data.order || a.data.title.localeCompare(b.data.title);

const projects = [
  ...visibleProjects.filter((project) => project.data.order === 0).sort(compareProjects),
  ...visibleProjects.filter((project) => project.data.order !== 0).sort(compareProjects),
];
---

<SiteLayout
        description="Alyosha's personal site. Software, Papers, and Notes."
  shellClass="home-shell"
>
      <section>
        <h2>Writing</h2>
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/writing/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              <span>{post.data.title}</span>
            </a>
          ))}
        </div>
        <p class="section-more"><a href="/writing/">All writing →</a></p>
      </section>

      <section>
        <h2>Projects</h2>
        <div class="project-list">
          {projects.map((project) => (
            <article class:list={{ 'project-featured': project.data.order === 0 }}>
              <div>
                <h3>
                  {project.data.order === 0 && <span class="project-pin">Pinned</span>}
                  {project.data.title}
                  {project.data.status && <span aria-label={project.data.status}> ({project.data.status})</span>}
                </h3>
                <p>{project.data.description}</p>
              </div>
              <a href={project.data.source}>Source →</a>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2>Who I am</h2>
        <p>
          I’m Mohit Guleria, usually Alyosha online. I did my undergrad at IIT
          Roorkee, and I’m a software engineer.
        </p>
        <p>
          I’m interested in agents and in the systems beneath the software we
          use every day. I like exploring the machinery: runtimes,
          sandboxes, developer tools, and the parts that explain how a system
          behaves, why it behaves that way. 
          Sometimes I fight temptations to recreate popular tools and frameworks 
          from scratch, just to see whether I'd make the same design choices at crossroads. 
        </p>
      </section>

      <section>
        <h2>Elsewhere</h2>
        <ul class="link-list">
          <li><a href="https://github.com/alyosha31">GitHub</a> — code and ongoing work</li>
          <li><a href="https://x.com/alyosha313">Twitter</a> — twitter</li>
          <li><a href="https://github.com/alyosha31/personal-site">This website</a> — source repository</li>
        </ul>
      </section>
</SiteLayout>
